{
  "manifest_version": 3,
  "name": "Nexus Mods Media Preview",
  "version": "2.0.0",
  "description": "Adds quick media previews to Nexus Mods and La Confrerie des Traducteurs.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.nexusmods.com/*",
        "https://www.confrerie-des-traducteurs.fr/*",
        "https://confrerie-des-traducteurs.fr/*"
      ],
      "js": [
        "src/settings.js",
        "src/description.js",
        "src/sources.js",
        "src/modal-drag.js",
        "src/viewer.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "clipboardWrite",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://www.nexusmods.com/*",
    "https://staticdelivery.nexusmods.com/*",
    "https://www.confrerie-des-traducteurs.fr/*",
    "https://confrerie-des-traducteurs.fr/*",
    "https://mods.confrerie-des-traducteurs.fr/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/viewer.css",
        "src/styles.css"
      ],
      "matches": [
        "https://www.nexusmods.com/*",
        "https://www.confrerie-des-traducteurs.fr/*",
        "https://confrerie-des-traducteurs.fr/*"
      ]
    }
  ]
}
